            <min>10.0</min>
            <max>100.0</max>
          </filter>
          <filter class='categorical' column='[federated.05nialv1wbjd4w11hu59x0fh4y2k].[none:region_origen:nk]'>
            <groupfilter function='member' level='[none:region_origen:nk]' member='&quot;Bogota&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
