            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.05nialv1wbjd4w11hu59x0fh4y2k'>
            <column caption='Precio (Valor)' datatype='real' name='[Calculation_1221070769487876]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;    LEFT(&#13;&#10;        [price],&#13;&#10;        FIND([price], &quot;.&quot;) - 1&#13;&#10;    )&#13;&#10;)&#13;&#10;+&#13;&#10;FLOAT(&#13;&#10;    RIGHT(&#13;&#10;        [price],&#13;&#10;        LEN([price]) - FIND([price], &quot;.&quot;)&#13;&#10;    )&#13;&#10;)&#13;&#10;/&#13;&#10;POWER(&#13;&#10;    10,&#13;&#10;    LEN([price]) - FIND([price], &quot;.&quot;)&#13;&#10;)' />
            </column>
            <column-instance column='[Calculation_1221070769487876]' derivation='Avg' name='[avg:Calculation_1221070769487876:vtavg:qk]' pivot='key' type='quantitative' visual-totals='Avg' />
            <column caption='Latitude' datatype='real' name='[latitude]' role='dimension' semantic-role='[Geographical].[Latitude]' type='ordinal' />
