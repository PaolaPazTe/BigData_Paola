            <column-instance column='[longitude]' derivation='None' name='[none:longitude:ok]' pivot='key' type='ordinal' />
            <column-instance column='[region_origen]' derivation='None' name='[none:region_origen:nk]' pivot='key' type='nominal' />
            <column aggregation='CountD' datatype='string' default-format='*10.58' name='[price]' role='dimension' type='nominal' />
            <column caption='Region Origen' datatype='string' name='[region_origen]' role='dimension' type='nominal' />
          </datasource-dependencies>
